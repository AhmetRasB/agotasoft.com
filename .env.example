# Copy this file to .env and fill in real values.
# Never commit .env or production secrets.

APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_PUBLIC_URL=http://localhost:3000
APP_KEY=change-this-to-a-long-random-string

# MySQL / MariaDB (phpMyAdmin import: database/install.sql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=agotasoft_web
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Session cookie
SESSION_NAME=agotasoft_cms
SESSION_SECURE=false
SESSION_SAMESITE=Lax
SESSION_SAVE_PATH=

# SMTP — leave blank locally; contact form still saves to the database
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@agotasoft.com
MAIL_FROM_NAME="AgotaSoft"
MAIL_ADMIN_TO=info@agotasoft.com

# JSON files the Next.js site reads at runtime (comma-separated, relative to this .env file)
# Local: sofax/public/data/site.json
# Shared hosting (Next export in document root): data/site.json
CMS_JSON_PATHS=sofax/public/data/site.json,data/site.json
