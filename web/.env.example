# Local only. Next.js reads published CMS JSON from /data/site.json,
# and posts the contact form to this PHP origin.
NEXT_PUBLIC_CMS_API=http://127.0.0.1:8080

# Measurement (docs/OLCUM.md). Leave empty to ship without any tracking or cookie banner.
# Google Tag Manager container id, e.g. GTM-XXXXXXX. GA4, Meta Pixel, Google Ads, Clarity are tags inside it.
NEXT_PUBLIC_GTM_ID=
