{
  "routes": [
    {
      "route": "/",
      "serve": "/index.html"
    },
    {
      "route": "/about-us",
      "serve": "/about-us.html"
    },
    {
      "route": "/contact-us", 
      "serve": "/contact-us.html"
    },
    {
      "route": "/erp",
      "serve": "/erp.html"
    },
    {
      "route": "/crm",
      "serve": "/crm.html"
    },
    {
      "route": "/pre-accounting",
      "serve": "/pre-accounting.html"
    },
    {
      "route": "/lms",
      "serve": "/lms.html"
    },
    {
      "route": "/pricing",
      "serve": "/pricing.html"
    },
    {
      "route": "/service",
      "serve": "/service.html"
    },
    {
      "route": "/404",
      "serve": "/404.html"
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/images/**",
      "/css/**",
      "/js/**",
      "/_next/**",
      "/favicon.ico",
      "/robots.txt",
      "/sitemap.xml"
    ]
  },
  "mimeTypes": {
    ".json": "application/json",
    ".css": "text/css",
    ".js": "application/javascript",
    ".png": "image/png",
    ".jpg": "image/jpeg",
    ".svg": "image/svg+xml"
  },
  "globalHeaders": {
    "Cache-Control": "public, max-age=31536000, immutable"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  }
}
